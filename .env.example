# ==============================================================================
# ANOS VOLDIGOAD MINI MD v4.0 — Environment Configuration Example
# GoldenBoy DEV™ — Production-Ready Multi-Session Architecture
# ==============================================================================

# Server Network & Ports
PORT=20338
SERVER_PORT=20338
NODE_ENV=production

# Security & API Authentication
# CHANGE THIS TO A STRONG RANDOM KEY FOR PRODUCTION (used in header 'x-api-key')
API_KEY=anos-admin-secret-key-2026
CORS_ORIGINS=http://localhost:20338,http://127.0.0.1:20338

# Multi-Session & Concurrency Limits
MAX_SESSIONS=1000
MAX_ACTIVE_CONNECTIONS=500
BATCH_RESTORE_SIZE=20
BATCH_RESTORE_DELAY_MS=300

# Reconnection & Backoff Policy
MAX_RESTART_ATTEMPTS=8
INITIAL_RECONNECT_DELAY_MS=2000
MAX_RECONNECT_DELAY_MS=60000
RECONNECT_JITTER_RATIO=0.3

# Automatic Session Deletion Policy
# When true: sessions permanently logged out (401 / badSession) are automatically deleted
AUTO_DELETE_ON_LOGOUT=true

# Pairing Security & Rate Limits
RATE_LIMIT_PAIR=3
RATE_LIMIT_PAIR_PER_NUMBER=5
PAIRING_TIMEOUT_MS=300000

# Bot Identity Defaults
BOT_NAME=𝐀𝐍𝐎𝐒_𝐕𝐎𝐋𝐃𝐈𝐆𝐎𝐀𝐃_𝐌𝐈𝐍𝐈_𝐌𝐃
PREFIX=.
OWNER_NAME=GoldenBoy Dev™
WORK_TYPE=public

# Automation & Group Management
AUTO_VIEW_STATUS=true
AUTO_LIKE_STATUS=true
AUTO_STATUS_REPLY=false
AUTO_STATUS_MSG=🤗
READ_MESSAGE=false
AUTO_TYPING=false
AUTO_RECORDING=false
ANTI_CALL=false
ANTIDELETE=true
WELCOME_ENABLE=true
GOODBYE_ENABLE=true

# Cache & Storage Optimization
GROUP_METADATA_CACHE_TTL_MS=60000
STATS_FLUSH_INTERVAL_MS=15000
MESSAGE_CACHE_MAX=500
LOG_FLUSH_INTERVAL_MS=1000
LOG_LEVEL=info
MEDIA_CONCURRENCY_LIMIT=5

# Optional WhatsApp Web Version Override (e.g. 2.3000.1015901307)
# Leave empty for automatic resolution
WA_VERSION=
